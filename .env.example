# CASTER configuration. Copy to `.env`; `.env` is gitignored.
#
# The rule behind this file is Invariant 13: **every value that changes a
# measured quantity is either in a key or in the shard's `.meta.json`.** The
# cache key covers model, temperature, prompt, max_tokens and the nonce. The
# dangerous half is everything else — the served context window, the sandbox
# timeout, the interpreter version, the backend — and those travel on the
# protocol record instead. A value in neither is a free variable.

# ── where a run writes ───────────────────────────────────────────────────────
# One path resolver decides (Invariant 5). Unset resolves to data/ and logs/.
# RUN_DIR=campaign-7b

# Cross-run stores. Deliberately NOT under RUN_DIR: the response cache is what
# makes a re-run free (Invariant 8), and the verdict and patch stores are its
# CPU-side siblings. Scoping any of them per run cold-starts every sweep.
# CACHE_DIR=cache
# VERDICT_DIR=verdicts
# PATCH_DIR=patches

# ── the benchmark ────────────────────────────────────────────────────────────
CONDEFECTS_ROOT=external/ConDefects
# Normally <root>/Test. Overridable because Test.zip is a 6.4 GB out-of-band
# download that can arrive incomplete: a partial tree can be salvaged elsewhere
# and pointed at from here, which keeps a truncated download from being frozen
# into a corpus by accident.
# CONDEFECTS_TEST_DIR=

# ── the sandbox ──────────────────────────────────────────────────────────────
# Both of these are part of the verdict: they enter `protocol_sha`, so changing
# one invalidates the verdict store by construction rather than silently mixing
# two instruments.
SANDBOX_TIMEOUT_SEC=60
# Contest solutions recurse over the whole input; CPython's default 1000 turns
# correct programs into RecursionErrors. A submission that sets its own limit to
# 10^6 can still blow the C stack, which surfaces as WorkerCrash.
SANDBOX_RECURSION_LIMIT=10000

# ── the proposer ─────────────────────────────────────────────────────────────
# Pin a hosted model by EXACT SNAPSHOT ID, never a bare alias. A hosted
# model silently re-pointed is a different instrument with nothing to say so.
MODEL=
TEMPERATURE=1.0
# Only for the o-series. Setting it on a chat model is refused: it would enter
# the cache key and the cell key while changing nothing about the call.
REASONING_EFFORT=

# Point this at the gateway, not at a backend. Shards know nothing about how
# many replicas there are.
LLM_BASE_URL=
LLM_API_KEY=

# The SDK's default is 600s. A local 7B at ~16 tok/s needs ~1000s to fill a
# 16000-token ceiling, so the default would abort a legitimate call and record
# it as a harness failure. Note this bounds ONE call end to end; the gateway's
# `queue_timeout` and `service_timeout` are the two things it was conflating.
LLM_TIMEOUT_SEC=1800
LLM_MAX_RETRIES=5

# THE SETTING THAT CAN CORRUPT A RUN SILENTLY. A server is free to TRUNCATE an
# over-long prompt rather than refuse it, and the served window reaches neither
# the cache key nor the record — so the same model id under a smaller window is
# a different instrument and nothing says so. Worse, it lands differentially:
# the steered arms carry the longest prompts. 0 disables the check; don't.
LLM_CONTEXT_TOKENS=32768

# ── money ────────────────────────────────────────────────────────────────────
# The GATEWAY owns the real cap. This per-process value is the fallback
# for a shard that bypasses it — and N shards each honouring it is a real
# ceiling of N× this number, which is the bug the gateway exists to fix.
BUDGET_USD_CAP=25
PRICE_IN_PER_MTOK=0
PRICE_OUT_PER_MTOK=0
